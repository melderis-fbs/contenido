# Integración interna de Notion. Creala en https://www.notion.so/my-integrations
# y dale acceso a la base de datos de contenido.
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxx

# ID de la base de datos de Notion (el UUID en la URL de la página)
NOTION_DATABASE_ID=6cad5775bc354a3cbacce58dada01770

# ID del data source (si la base tiene múltiples fuentes)
NOTION_DATA_SOURCE_ID=24201b34-ecd4-4539-9d8f-e5773878de18

# Contraseña para entrar a la app (compártila con las usuarias)
APP_PASSWORD=founders2024

# Clave de Anthropic — para generar captions y el reporte mensual con IA
# Obtenerla en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxx

# Slack — para enviar el reporte mensual a un canal
# 1. Crear una app en https://api.slack.com/apps
# 2. Agregar el scope "chat:write" en Bot Token Scopes
# 3. Instalar en el workspace y copiar el Bot Token (xoxb-...)
# 4. Invitar el bot al canal: /invite @nombre-del-bot
# 5. Copiar el Channel ID (clic derecho en el canal → Copy link → el ID es el C... al final)
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxx
SLACK_CHANNEL_ID=C0123456789

# Página de Notion donde se guardan los reportes semanales
# 1. Creá una página llamada "Reportes" en tu workspace de Notion
# 2. Compartila con la integración (los tres puntos → Connections → agregar tu integración)
# 3. Copiá el ID de la URL (el UUID después del último slash, antes del ?)
NOTION_REPORTS_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
